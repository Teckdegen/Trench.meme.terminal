# trench.meme terminal - Vercel env
#
# Copy these into Vercel Project Settings > Environment Variables.
# Do not commit real secrets. The bot has its own Railway env in bot/.env.example.

# Supabase browser config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server config
# Used by TanStack server functions. Keep server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Para embedded wallets
# Use the same production Para app values in Vercel and Railway.
VITE_PARA_API_KEY=
PARA_API_KEY=
PARA_API_SECRET=

# Monad
VITE_MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_RPC_URL=https://rpc.monad.xyz
WMON_ADDRESS=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A

# Gun relay
# After Railway deploys bot/, set this to:
#   wss://YOUR-RAILWAY-DOMAIN/gun
# Local dev can use:
#   ws://localhost:8765/gun
VITE_GUN_PEERS=ws://localhost:8765/gun

# Trading data APIs
NADFUN_API_BASE=https://api.nad.fun
NADFUN_API_KEY=
GECKOTERMINAL_NETWORK=monad
ZERION_API_KEY=
ZERION_CHAIN_SLUG=monad

# Cabal voice rooms, optional
VITE_AGORA_APP_ID=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Fees
# Must match Railway bot env. Only put the public fee wallet address here.
FEE_WALLET_ADDRESS=
FEE_BPS_MARKET=85
FEE_BPS_LIMIT=250
FEE_BPS_COPY=350

# Referrals
DEFAULT_REFERRAL_CODE=trench001

# Analytics, optional
VITE_PLAUSIBLE_DOMAIN=
