# trench.meme terminal - Railway bot env
#
# Copy these into Railway Variables for the bot/ service.
# Do not commit real secrets.

# Supabase
SUPABASE_URL=
# Optional alias if you copy from Vercel env. The bot accepts either.
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Para server signing
PARA_API_KEY=
# Optional alias if you copy from Vercel env. The bot accepts either.
VITE_PARA_API_KEY=
PARA_API_SECRET=

# Monad
MONAD_RPC_URL=https://rpc.monad.xyz
DIROL_API_BASE=https://api.dirol.io/api/v1

# Gun relay
PORT=8765
GUN_HOST=0.0.0.0
GUN_DATA_DIR=./gun-data
# Production: set to your Vercel origin, e.g. https://trench-meme-terminal.vercel.app.
# Local/public testing can use *.
GUN_ALLOW_ORIGIN=*
GUN_MAX_MESSAGE_AGE_DAYS=90

# Fees and cashback redemption
FEE_WALLET_ADDRESS=
FEE_WALLET_PRIVATE_KEY=
FEE_BPS_MARKET=85
FEE_BPS_LIMIT=250
FEE_BPS_COPY=350

# Worker timing
COPY_SLIPPAGE_BPS=100
EXECUTOR_BATCH_SIZE=5
LIMIT_INTERVAL_MS=10000
EXECUTOR_INTERVAL_MS=800
ALERT_INTERVAL_MS=20000
PNL_INTERVAL_MS=300000
SMART_MONEY_INTERVAL_MS=900000
BUBBLE_MAP_INTERVAL_MS=1800000
FEED_RANKER_INTERVAL_MS=60000
REDEMPTION_INTERVAL_MS=30000
